{
  "_schema": {
    "note": "Un objet par perso. type DOIT etre dans: projectile, burst, zone, dash, shield. Rien d'autre. L'equipe persos remplit ce fichier, ne touche pas au code.",
    "fields": {
      "name": "affiche a l'ecran",
      "hp": "points de vie",
      "speed": "vitesse px/s",
      "sprite": "chemin d'un PNG servi par Vite (ex: sprites/trump.png, fichier dans client/public/sprites/) OU id de crane genere au runtime (client/sprites.js) si pas de PNG",
      "attack/defense/super": "un pouvoir chacun, parametre une des 5 briques",
      "labKit": "optionnel, true = regles du kit labo: acceleration au contact, defense/super a l'appui seulement, pas de pouvoir pendant un dash, effets labo cote client",
      "fullBody": "optionnel, true = sprite PNG dessine en pied (grande taille) au lieu du format tete",
      "shieldStyle": "optionnel, 'sunglasses' = bulle bleue + lunettes de soleil sur le sprite pendant le bouclier",
      "hint": "optionnel, texte d'aide affiche sur la manette sous les boutons",
      "behavior (dans un pouvoir)": "optionnel, un pouvoir avec behavior passe par le code labo (server/lab-combat.js), sinon par les 5 briques"
    }
  },
