{
  "name": "showerbrawl",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "loadtest": "node scripts/loadtest.js",
    "predev:all": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "dev:all": "concurrently -k \"node server/index.js\" \"vite\"",
    "start:all": "npm run dev:all",
    "test": "node --test tests/*.test.js laboratoire/maison-blanche/tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nipplejs": "^1.0.4",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright-core": "1.56",
    "vite": "^8.3.1"
  }
}
